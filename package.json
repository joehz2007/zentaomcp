{
  "name": "zentao-mcp",
  "version": "0.1.0",
  "description": "MCP server for ZenTao 18.13 read-only integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zentao-mcp": "dist/index.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test --experimental-test-isolation=none --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "pack:local": "npm pack",
    "prepublish:check": "npm run check && npm run test && npm run build",
    "publish:npm": "npm publish --registry https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "zentao",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
